character_name = "Professor Panik"
dialogs = ["Hello young hero! What a lovely sword you have there...it looks perfect for fighting monsters!", "You might've heard already, but strange things have been happening recently.", "THE MAD DEER has infected animals across our town with his curse.", "Friends, lovers, parents and children. They've turned their fangs against each other. The smell of blood lingers.", "This town needs you! Here, take this potion and cure our friends of their disease! ", "Head north: there have been reports of screams coming from the old abandoned house..."]

